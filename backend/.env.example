# Copy to `backend/.env` and fill in. `.env` is gitignored — never commit real keys.

# Optional: enables live Gemini narration for the chat (grounded + validated).
# Get a key at https://aistudio.google.com/apikey (standard keys start with "AIza").
# If unset or invalid, the app runs fully offline on deterministic templates.
GEMINI_API_KEY=

# Optional: Gemini model id (default: gemini-flash-latest).
GEMINI_MODEL=gemini-flash-latest

# Optional: hard timeout (seconds) for a Gemini call before falling back to the
# instant offline template. Keeps chat latency bounded (default: 12).
GEMINI_TIMEOUT=10

# Optional: neural TTS voice via edge-tts (needs internet). Else browser speech.
ENABLE_TTS=

# Optional: governance kill-switch. "on" (default) | "info_only".
ADVISORY_MODE=on
